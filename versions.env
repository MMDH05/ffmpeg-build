# Pinned source versions. Bump here, then tag a release (see README).
#
# FFMPEG_VERSION matches the Windows gyan build pinned in downlodr's
# package.json (downlodrBinaries.ffmpeg), so both platforms run the same
# af_whisper filter. It must stay >= 8.0.1: 8.0.0's whisper filter drops the
# first byte of every cue.
FFMPEG_VERSION=9.0.1
FFMPEG_SHA256=cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635

# ffmpeg's configure requires whisper >= 1.7.5.
WHISPER_VERSION=1.9.4
WHISPER_SHA256=57e280cee375ab02425b806ad5146b99f6eb9357e3c2b31357c8a6af2e2e44ae

# Electron 33 (downlodr) supports macOS 11+.
MACOSX_DEPLOYMENT_TARGET=11.0
